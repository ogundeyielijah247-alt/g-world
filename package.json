{
  "name": "g-world-phase-1",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "dev:api": "wrangler dev --config worker/wrangler.toml --ip 0.0.0.0 --port 8787",
    "db:local": "wrangler d1 execute g-world --local --config worker/wrangler.toml --file=schema/schema.sql",
    "dev:full": "node scripts/dev.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "dev:frontend": "vite"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^7.1.0",
    "wrangler": "^4.151.1"
  }
}
