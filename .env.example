# Copy to .env for local development
# Base URL of the G WORLD API (Cloudflare Worker)
VITE_API_BASE_URL=http://127.0.0.1:8787

# Base URL used when generating the member-card verification QR.
# Defaults to VITE_API_BASE_URL. Set this when the API and the public
# verify page live on different hosts.
VITE_VERIFY_BASE_URL=
